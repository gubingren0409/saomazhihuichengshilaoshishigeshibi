{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R3 shared geospatial evidence bundle",
  "description": "Provider-specific observation and shared WGS84 request data, without inferred graph edges.",
  "type": "object",
  "required": [
    "schema_version",
    "scene",
    "entrances",
    "features",
    "feature_availability",
    "route_requests",
    "route_results",
    "access_candidates",
    "access_candidates_availability",
    "topology_availability"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "scene": {
      "$ref": "#/$defs/MapScene"
    },
    "entrances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EntranceReference"
      },
      "minItems": 0
    },
    "features": {
      "type": "object",
      "required": [
        "buildings",
        "pedestrian",
        "open_spaces"
      ],
      "properties": {
        "buildings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BuildingFeature"
          },
          "minItems": 0
        },
        "pedestrian": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PedestrianFeature"
          },
          "minItems": 0
        },
        "open_spaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpenSpaceFeature"
          },
          "minItems": 0
        }
      },
      "additionalProperties": false
    },
    "feature_availability": {
      "type": "object",
      "required": [
        "buildings",
        "pedestrian",
        "open_spaces"
      ],
      "properties": {
        "buildings": {
          "enum": [
            "OBSERVED_CLIP",
            "UNKNOWN"
          ]
        },
        "pedestrian": {
          "enum": [
            "OBSERVED_CLIP",
            "UNKNOWN"
          ]
        },
        "open_spaces": {
          "enum": [
            "OBSERVED_CLIP",
            "UNKNOWN"
          ]
        }
      },
      "additionalProperties": false
    },
    "route_requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RouteRequest"
      },
      "minItems": 1
    },
    "route_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RouteResult"
      },
      "minItems": 1
    },
    "access_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AccessCandidate"
      },
      "minItems": 0
    },
    "access_candidates_availability": {
      "enum": [
        "OBSERVED_CANDIDATE",
        "UNKNOWN"
      ]
    },
    "topology_availability": {
      "enum": [
        "NATIVE_MEMBERSHIP_AND_FROZEN_PROFILE",
        "NATIVE_MEMBERSHIP",
        "UNKNOWN"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Coordinate": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "Bounds": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "Artifact": {
      "type": "object",
      "required": [
        "scope",
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "scope": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "required": [
        "provider",
        "status",
        "artifacts"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "status": {
          "enum": [
            "OBSERVED",
            "RECOMPUTED",
            "INFERRED",
            "UNKNOWN"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "minItems": 0
        }
      },
      "additionalProperties": false
    },
    "Geometry": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Point"
            },
            "coordinates": {
              "$ref": "#/$defs/Coordinate"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "LineString"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Coordinate"
              },
              "minItems": 2
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Coordinate"
                },
                "minItems": 4
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiPolygon"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Coordinate"
                  },
                  "minItems": 4
                },
                "minItems": 1
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "RouteGeometry": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "MultiLineString"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Coordinate"
            },
            "minItems": 2
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "MapScene": {
      "type": "object",
      "required": [
        "kind",
        "scene_id",
        "label",
        "bounds",
        "crs",
        "coordinate_order",
        "timestamp",
        "timestamp_status",
        "attribution",
        "requested_views",
        "retained_views",
        "source"
      ],
      "properties": {
        "kind": {
          "const": "MapScene"
        },
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bounds"
            },
            {
              "type": "null"
            }
          ]
        },
        "crs": {
          "const": "EPSG:4326"
        },
        "coordinate_order": {
          "const": "longitude,latitude"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp_status": {
          "enum": [
            "OBSERVED",
            "UNKNOWN"
          ]
        },
        "attribution": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_views": {
          "type": "object"
        },
        "retained_views": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "additionalProperties": false
    },
    "EntranceReference": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "coordinate",
        "grade",
        "current_access",
        "selected_for_request",
        "physical_validation",
        "source",
        "native_fields"
      ],
      "properties": {
        "kind": {
          "const": "EntranceReference"
        },
        "id": {
          "type": "string"
        },
        "coordinate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinate"
            },
            {
              "type": "null"
            }
          ]
        },
        "grade": {
          "enum": [
            "VERIFIED_FIELD",
            "VERIFIED_OFFICIAL",
            "OSM_TAGGED",
            "POI_ENTRANCE",
            "PROXY_OR_UNCERTAIN",
            "UNKNOWN"
          ]
        },
        "current_access": {
          "const": "UNKNOWN"
        },
        "selected_for_request": {
          "type": "boolean"
        },
        "physical_validation": {
          "enum": [
            "FIELD",
            "UNKNOWN"
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "native_fields": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "RouteRequest": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "role",
        "origin",
        "target",
        "mode",
        "profile",
        "status",
        "source",
        "constraints"
      ],
      "properties": {
        "kind": {
          "const": "RouteRequest"
        },
        "id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "TARGET_REQUEST",
            "APPROACH_DIAGNOSTIC"
          ]
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinate"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinate"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "const": "walk"
        },
        "profile": {
          "type": "string"
        },
        "status": {
          "enum": [
            "REQUEST_COORDINATES_AVAILABLE",
            "REQUEST_INPUT_MISSING"
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "constraints": {
          "type": "object",
          "required": [
            "snap_limit_m",
            "snap_limit_status"
          ],
          "properties": {
            "snap_limit_m": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "snap_limit_status": {
              "enum": [
                "OBSERVED",
                "UNKNOWN"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Snap": {
      "type": "object",
      "required": [
        "coordinate",
        "status",
        "distance_m",
        "native_edge",
        "source",
        "native_fields"
      ],
      "properties": {
        "coordinate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinate"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "OBSERVED",
            "UNKNOWN"
          ]
        },
        "distance_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_edge": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "native_fields": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "RouteResult": {
      "type": "object",
      "required": [
        "kind",
        "request_id",
        "role",
        "status",
        "failure_reason",
        "geometry",
        "geometry_status",
        "route_origin",
        "route_end",
        "route_end_role",
        "engine",
        "distance",
        "snap_origin",
        "snap_target",
        "arrival_at_verified_entrance",
        "source",
        "native_fields"
      ],
      "properties": {
        "kind": {
          "const": "RouteResult"
        },
        "request_id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "TARGET_REQUEST",
            "APPROACH_DIAGNOSTIC"
          ]
        },
        "status": {
          "type": "string"
        },
        "failure_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteGeometry"
            },
            {
              "type": "null"
            }
          ]
        },
        "geometry_status": {
          "enum": [
            "OBSERVED",
            "UNKNOWN"
          ]
        },
        "route_origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinate"
            },
            {
              "type": "null"
            }
          ]
        },
        "route_end": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinate"
            },
            {
              "type": "null"
            }
          ]
        },
        "route_end_role": {
          "enum": [
            "RETURNED_ROUTE_VERTEX",
            "UNKNOWN"
          ]
        },
        "engine": {
          "type": "string"
        },
        "distance": {
          "type": "object",
          "required": [
            "reported_m",
            "geometry_m",
            "geometry_metric",
            "duration_s"
          ],
          "properties": {
            "reported_m": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "geometry_m": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "geometry_metric": {
              "type": "string"
            },
            "duration_s": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "snap_origin": {
          "$ref": "#/$defs/Snap"
        },
        "snap_target": {
          "$ref": "#/$defs/Snap"
        },
        "arrival_at_verified_entrance": {
          "const": "UNKNOWN"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "native_fields": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "AccessCandidate": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "coordinate",
        "role",
        "entrance_identity",
        "native_edge",
        "distance_to_request_target_m",
        "source",
        "native_fields"
      ],
      "properties": {
        "kind": {
          "const": "AccessCandidate"
        },
        "id": {
          "type": "string"
        },
        "coordinate": {
          "$ref": "#/$defs/Coordinate"
        },
        "role": {
          "const": "NEAREST_ELIGIBLE_NETWORK_POINT"
        },
        "entrance_identity": {
          "const": "UNKNOWN"
        },
        "native_edge": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "distance_to_request_target_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "native_fields": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "BuildingFeature": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "category",
        "geometry",
        "geometry_status",
        "access_state",
        "source",
        "native_fields"
      ],
      "properties": {
        "kind": {
          "const": "BuildingFeature"
        },
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ]
        },
        "geometry_status": {
          "enum": [
            "OBSERVED",
            "RECOMPUTED",
            "UNKNOWN"
          ]
        },
        "access_state": {
          "enum": [
            "TAGGED_ALLOWED",
            "TAGGED_RESTRICTED",
            "UNKNOWN"
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "native_fields": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "PedestrianFeature": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "category",
        "geometry",
        "geometry_status",
        "access_state",
        "source",
        "native_fields"
      ],
      "properties": {
        "kind": {
          "const": "PedestrianFeature"
        },
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ]
        },
        "geometry_status": {
          "enum": [
            "OBSERVED",
            "RECOMPUTED",
            "UNKNOWN"
          ]
        },
        "access_state": {
          "enum": [
            "TAGGED_ALLOWED",
            "TAGGED_RESTRICTED",
            "UNKNOWN"
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "native_fields": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "OpenSpaceFeature": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "category",
        "geometry",
        "geometry_status",
        "access_state",
        "source",
        "native_fields"
      ],
      "properties": {
        "kind": {
          "const": "OpenSpaceFeature"
        },
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ]
        },
        "geometry_status": {
          "enum": [
            "OBSERVED",
            "RECOMPUTED",
            "UNKNOWN"
          ]
        },
        "access_state": {
          "enum": [
            "TAGGED_ALLOWED",
            "TAGGED_RESTRICTED",
            "UNKNOWN"
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "native_fields": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
